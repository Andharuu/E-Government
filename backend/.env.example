# ============================================================
# GovConnect Backend Environment Configuration
# ============================================================

# Mode Lingkungan (development / production / testing)
ENVIRONMENT=development
APP_NAME="GovConnect API Engine"
APP_VERSION="2.0.0"
API_V1_PREFIX="/api/v1"

# Basis Data:
# Untuk Docker/Produksi MySQL:
DATABASE_URL="mysql+pymysql://govuser:govpassword@localhost:3306/govconnect_db"
# Untuk Pengujian/Local Dev Ringan (SQLite):
# DATABASE_URL="sqlite:///./govconnect.db"

SQL_ECHO=false

# Keamanan JWT (Ganti SECRET_KEY di lingkungan produksi!)
SECRET_KEY="govconnect-super-secret-jwt-token-key-2026-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 hari

# Keamanan CORS (pisahkan dengan koma)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
CORS_ORIGIN_REGEX="^chrome-extension://[a-zA-Z0-9]+$"

# Batas Laju Permintaan (Rate Limiting)
RATE_LIMIT_LOGIN_PER_MINUTE=15
RATE_LIMIT_GENERAL_PER_MINUTE=120
