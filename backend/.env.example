# ============================================================
# GovConnect Backend Environment Configuration (TEMPLATE)
# ============================================================
# Salin file ini ke `.env` lalu isi nilai rahasia. JANGAN commit `.env`.
# ============================================================

# Mode Lingkungan (development / production / testing)
ENVIRONMENT=development
APP_NAME="GovConnect API Engine"
APP_VERSION="2.0.0"
API_V1_PREFIX="/api/v1"

# Basis Data (ganti kredensial — JANGAN pakai nilai contoh di produksi):
DATABASE_URL="sqlite:///./govconnect.db"
# MySQL produksi:
# DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:3306/govconnect_db"

SQL_ECHO=false

# ------------------------------------------------------------------
# KEAMANAN — WAJIB DIISI. Aplikasi akan MENOLAK start bila kosong/default.
# Generate dengan:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------
# Kunci penandatanganan JWT (BERBEDA dari kunci PII):
SECRET_KEY=""
# Kunci enkripsi PII (field-level). WAJIB berbeda dari SECRET_KEY:
PII_ENCRYPTION_KEY=""

# Email admin (dipisah koma) yang di-promote otomatis saat startup.
# Kosongkan bila tidak ingin promosi otomatis.
ADMIN_EMAILS=""

ALGORITHM="HS256"
# Umur access token dalam menit (default 12 jam). Perpendek untuk keamanan lebih ketat.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Keamanan CORS (pisahkan dengan koma)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
CORS_ORIGIN_REGEX="^chrome-extension://[a-zA-Z0-9]+$"

# Batas Laju Permintaan (Rate Limiting)
RATE_LIMIT_LOGIN_PER_MINUTE=15
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Proxy tepercaya (T3). X-Forwarded-For HANYA dipercaya bila koneksi langsung
# berasal dari salah satu IP ini. Kosongkan bila backend tidak di belakang proxy
# (header XFF akan diabaikan sepenuhnya).
TRUSTED_PROXIES=""
