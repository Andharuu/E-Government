# ============================================================
# GovConnect Backend Configuration (.env.example)
# ============================================================

# Informasi Aplikasi
APP_NAME="GovConnect API Engine"
APP_VERSION="2.0.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"

# Basis Data
# Default: SQLite lokal untuk development/testing
DATABASE_URL="sqlite:///./govconnect.db"
# Untuk produksi (MySQL):
# DATABASE_URL="mysql+pymysql://govconnect_user:your_password@localhost:3306/govconnect_db"
SQL_ECHO="false"

# Keamanan Kriptografi & JWT
# WAJIB diisi dengan string acak minimal 32 karakter
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="720"

# Kunci Enkripsi PII (Field-level encryption)
# WAJIB BERBEDA DARI SECRET_KEY!
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_ENCRYPTION_KEY=""

# Keamanan CORS
ALLOWED_ORIGIN="chrome-extension://<EXTENSION_ID>"
CORS_ORIGIN_REGEX="^chrome-extension://[a-zA-Z0-9]+$"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Admin Provisioning (email dipisahkan tanda koma)
ADMIN_EMAILS="admin@govconnect.id"

# Rate Limiting (SlowAPI)
RATE_LIMIT_LOGIN_PER_MINUTE="15"
RATE_LIMIT_GENERAL_PER_MINUTE="120"

# Reverse Proxy Tepercaya (Nginx/Traefik IP jika ada)
TRUSTED_PROXIES=""

