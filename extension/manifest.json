{
  "manifest_version": 3,
  "name": "GovConnect Autofill Assistant",
  "version": "1.0.0",
  "description": "Ekstensi asisten pengisian formulir layanan publik otomatis.",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Buka GovConnect"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ]
}