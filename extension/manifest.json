{
  "manifest_version": 3,
  "name": "GovConnect Autofill Assistant",
  "version": "2.0.0",
  "description": "Asisten pengisian formulir layanan publik otomatis berbasis data profil kependudukan.",
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "https://www.roboform.com/*",
    "https://roboform.com/*",
    "https://demoqa.com/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "logo-white-blue.png",
    "32": "logo-white-blue.png",
    "48": "logo-white-blue.png",
    "128": "logo-white-blue.png"
  },
  "action": {
    "default_title": "GovConnect Autofill Assistant",
    "default_icon": {
      "16": "logo-white-blue.png",
      "32": "logo-white-blue.png",
      "48": "logo-white-blue.png",
      "128": "logo-white-blue.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.js",
        "logo-white.png",
        "logo-white-blue.png",
        "fontawesome/*",
        "uicons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}