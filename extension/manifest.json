{
  "manifest_version": 3,
  "name": "GovConnect Autofill Assistant",
  "version": "2.0.0",
  "description": "Asisten pengisian formulir layanan publik otomatis berbasis data profil kependudukan.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 https://api.govconnect.app https://cdn.jsdelivr.net https://unpkg.com https://huggingface.co https://*.hf.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.huggingface.co;"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5174/*",
    "http://localhost:5174/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://cdn-lfs-us-1.huggingface.co/*",
    "https://cdn.jsdelivr.net/*",
    "https://unpkg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GovConnect Autofill Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "config.js",
        "sidepanel.html",
        "sidepanel.js",
        "logo-white.png",
        "logo-white-blue.png",
        "fontawesome/*",
        "uicons/*",
        "lib/*",
        "models/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "exclude_matches": [
        "*://*.klikbca.com/*",
        "*://*.ib.bri.co.id/*",
        "*://*.bankmandiri.co.id/*",
        "*://*.bni.co.id/*",
        "*://*.cimbniaga.co.id/*",
        "*://*.permatabank.com/*",
        "*://*.danamon.co.id/*",
        "*://*.paypal.com/*",
        "*://*.stripe.com/*"
      ]
    }
  ]
}