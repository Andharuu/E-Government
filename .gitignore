# ==========================================
# GovConnect Unified .gitignore
# ==========================================

# --- Python & Virtual Environment ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# --- Node / Frontend (React & Vite) ---
node_modules/
dist/
dist-ssr/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# --- Environment Variables & Credentials ---
.env
.env.local
.env.*.local
*.env

# --- Database & Docker Local Data ---
*.sqlite3
mysql_data/

# --- IDE & Editor Specific ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# --- OS Specific Files ---
.DS_Store
Thumbs.db
desktop.ini